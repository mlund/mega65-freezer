# Static analysis for the llvm-mos build.
#
# Tuned to what actually finds bugs here. These checks caught real defects
# during the port: an array indexed past its end, a non-void function falling
# off the end, and an address laundered through an int so the compiler could
# not see the stores into it.
#
# The point of the exclusions is signal: 495 findings that are all style hide
# the three that are not. Every exclusion says why. Adding one should too.

Checks: >
  bugprone-*,
  clang-analyzer-*,
  portability-*,
  misc-*,
  readability-non-const-parameter,
  readability-misleading-indentation,
  readability-inconsistent-declaration-parameter-name,

  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-switch-missing-default-case,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -clang-analyzer-deadcode.DeadStores,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-security.insecureAPI.*,
  -misc-include-cleaner,
  -misc-no-recursion,

# This project's own headers, not the SDK's or mega65-libc's.
HeaderFilterRegex: '(freezer|freezer_common|fdisk_[a-z0-9_]+|helper|infohelper|cc65compat)\.h$'

# Advisory, not fatal: a false positive should not stop a build.
WarningsAsErrors: ''

# Why each exclusion:
#
#   bugprone-implicit-widening-of-multiplication-result
#       Real signal on a 16-bit-int target -- `sector * 512` overflows before
#       it widens to long -- but 103 sites swamp everything else, so it has its
#       own target: `cmake --build build --target tidy-widening`.
#
#   bugprone-switch-missing-default-case
#       The key-dispatch switches deliberately ignore unlisted keys.
#
#   bugprone-easily-swappable-parameters
#       lcopy(source, destination, count) mirrors the DMA controller's own
#       argument order; renaming would move this further from the hardware.
#
#   bugprone-narrowing-conversions
#       int is 16-bit and char 8-bit here, so every sector number and screen
#       offset trips it. Narrowing is how the code is written throughout.
#
#   bugprone-reserved-identifier
#       The __FDISK_MEMORY_H__ style guards predate the port, and a compat
#       header has to match one of them exactly in order to pre-empt it.
#
#   clang-analyzer-deadcode.DeadStores
#       Mostly hardware reads whose value is deliberately discarded, plus
#       partially-parsed structures in fdisk_fat32.c.
#
#   clang-analyzer-core.FixedAddressDereference
#       Dereferencing a fixed address is the entire job here: $D020 is the
#       border colour, not a wild pointer. Fires on every hardware access.
#
#   clang-analyzer-security.insecureAPI.*
#       Suggests strlcpy and the C11 _s functions, which this libc lacks.
#
#   misc-include-cleaner / misc-no-recursion
#       Both fire through SDK headers rather than through this code.
#
# Kept despite noise, because each has found a real bug here:
#   clang-analyzer-core.*   uninitialised reads, null dereferences
#   bugprone-branch-clone   duplicated conditional arms
#   readability-non-const-parameter
#
# readability-identifier-naming is absent on purpose: this tree tracks the
# upstream cc65 sources, and renaming would make diffing against them useless
# for no correctness gain. The previous config applied another project's Rust
# conventions, which is why it wanted `version` spelled `VERSION`.
